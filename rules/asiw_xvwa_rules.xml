  <!-- ================================================================
       1004NN : T3 CONFIRMED (bukti host)
       ================================================================ -->

  <!-- XV-01 T3: query berbahaya benar-benar dieksekusi pada DB xvwa.
       Bukti terkuat untuk SQLi (mapping S5). -->
  <rule id="100401" level="12">
    <if_sid>100120</if_sid>
    <field name="asiw_db_query" type="pcre2">(?i)(union(\s|/\*.*\*/)+select|information_schema|\bsleep\s*\(|\bbenchmark\s*\(|into\s+outfile|load_file\s*\(|\bor\s+1\s*=\s*1|\band\s+1\s*=\s*1)</field>
    <description>ASIW XV-01 T3: Malicious SQL executed on xvwa database.</description>
    <mitre><id>T1190</id></mitre>
    <group>host,sql_injection,db,asiw_t3,</group>
  </rule>

  <!-- XV-03 T3: user web mengeksekusi biner DI LUAR allowlist baseline.
       Baseline sah modul cmdi dari source XVWA: shell_exec('ping -c 3 ...'),
       jadi 'ping' dan shell perantara ('sh -c') adalah baseline (pengendali FP3).
       auditd key 'asiw_web_exec' hanya memantau euid user web
       (lihat agent/auditd/asiw-xvwa.rules).
       VERIFIKASI path ping pada VM: `command -v ping`. -->
  <rule id="100403" level="12">
    <if_sid>80700</if_sid>
    <field name="audit.key">^asiw_web_exec$</field>
    <!-- Cocokkan pada COMMAND BASENAME (comm), bukan path exe penuh.
         Alasan: bila XVWA berjalan di container, auditd host dapat
         melaporkan audit.exe sebagai path overlay
         (mis. /var/lib/docker/overlay2/.../usr/bin/ping), sehingga
         allowlist berbasis path penuh akan meleset dan ping SAH dari
         modul cmdi memicu alert. comm selalu "ping" terlepas dari overlay,
         jadi robust untuk native maupun Docker.
         Baseline sah modul cmdi = ping + shell perantara (sh/dash). -->
    <field name="audit.command" type="pcre2">^(?!ping$|sh$|dash$)\S+$</field>
    <description>ASIW XV-03 T3: Web user executed non-baseline command '$(audit.command)' (confirmed command execution).</description>
    <mitre><id>T1059.004</id></mitre>
    <group>host,command_execution,asiw_t3,</group>
  </rule>

  <!-- XV-03 T3b: shell interaktif / tool reverse shell oleh user web.
       Lebih tinggi dari 100403 karena pola khas post-exploitation. -->
  <rule id="100423" level="13">
    <if_sid>100403</if_sid>
    <field name="audit.command" type="pcre2">(?i)^(nc|ncat|netcat|socat|bash|zsh|ksh|python3?|perl|ruby|php|wget|curl)$</field>
    <description>ASIW XV-03 T3: Web user spawned interpreter or network tool '$(audit.command)' (likely reverse shell or payload download).</description>
    <mitre><id>T1059.004</id><id>T1105</id></mitre>
    <group>host,command_execution,asiw_t3,</group>
  </rule>

  <!-- XV-07 T3: file dengan ekstensi eksekutabel PHP muncul di direktori
       upload XVWA (/xvwa/img/uploads/). Mencakup double extension
       (mis. shell.php.jpg TIDAK cocok di sini; ditangani 100408 lewat YARA). -->
  <rule id="100407" level="12">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)/xvwa/img/uploads/.*\.(php|php3|php4|php5|php7|phtml|phar|pht|phps)$</field>
    <description>ASIW XV-07 T3: Executable file added to XVWA upload directory: $(file).</description>
    <mitre><id>T1505.003</id></mitre>
    <group>host,web_shell,file_integrity,asiw_t3,</group>
  </rule>

  <!-- XV-07 T3b: YARA mencocokkan konten berbahaya di direktori upload.
       Menutup kasus double extension dan polyglot (ekstensi .jpg tetapi
       isinya webshell) yang lolos dari 100407. -->
  <rule id="100427" level="14">
    <if_sid>100130</if_sid>
    <field name="file" type="pcre2">(?i)/xvwa/img/uploads?/</field>
    <field name="matches">\.+</field>
    <description>ASIW XV-07 T3: YARA matched $(matches) on uploaded file $(file) (confirmed malicious content).</description>
    <mitre><id>T1505.003</id></mitre>
    <group>host,web_shell,yara,asiw_t3,</group>
  </rule>

  <!-- XV-07 T3 varian ke-3: skrip Active Response YARA menolak nama berkas
       karena memuat karakter kendali (newline/CR). Nama berkas sepenuhnya
       dikendalikan penyerang pada XVWA (basename tanpa sanitasi), dan
       newline dapat dipakai untuk menyuntikkan baris log palsu.
       Penolakan itu sendiri adalah indikator serangan, jadi harus
       menghasilkan alert, bukan hilang tanpa jejak. -->
  <rule id="100447" level="12">
    <if_sid>100130</if_sid>
    <field name="matches">^ASIW_Suspicious_Filename$</field>
    <description>ASIW XV-07 T3: Uploaded filename contained control characters (log-injection attempt); file not scanned.</description>
    <mitre><id>T1505.003</id><id>T1070</id></mitre>
    <group>host,web_shell,evasion,asiw_t3,</group>
  </rule>

  <!-- XV-09 T3: payload XSS benar-benar tersimpan ke tabel comments.
       Bukti penulisan (bukan pemuatan) sesuai catatan korelasi mapping XV-09. -->
  <rule id="100409" level="11">
    <if_sid>100120</if_sid>
    <field name="asiw_db_cmd" type="pcre2">(?i)^query$</field>
    <field name="asiw_db_query" type="pcre2">(?i)insert.+comments.+(\x3cscript|\x3cimg|\x3csvg|\x3ciframe|onerror|onload|javascript:)</field>
    <description>ASIW XV-09 T3: XSS payload stored into comments table (persistent payload confirmed).</description>
    <mitre><id>T1059.007</id></mitre>
    <group>host,xss,db,asiw_t3,</group>
  </rule>

  <!-- XV-11 T3: proses web membuka koneksi keluar.
       auditd key 'asiw_web_connect' (syscall connect oleh euid user web). -->
  <rule id="100411" level="11">
    <if_sid>80700</if_sid>
    <field name="audit.key">^asiw_web_connect$</field>
    <description>ASIW XV-11 T3: Web process initiated an outbound connection (SSRF/RFI fetch or exfiltration).</description>
    <mitre><id>T1046</id><id>T1041</id></mitre>
    <group>host,ssrf,asiw_t3,</group>
  </rule>

  <!-- XV-11 T3b: SSRF menulis hasil unduhan ke /xvwa/img/ (source:
       file_put_contents("../../img/<rand>img1.jpg")). File baru di /xvwa/img/
       yang BUKAN di uploads menandakan fetch SSRF berhasil. -->
  <rule id="100431" level="11">
    <if_sid>554</if_sid>
    <field name="file" type="pcre2">(?i)/xvwa/img/\d+img1\.jpg$</field>
    <description>ASIW XV-11 T3: SSRF fetch artifact written to XVWA image directory: $(file).</description>
    <mitre><id>T1190</id></mitre>
    <group>host,ssrf,file_integrity,asiw_t3,</group>
  </rule>

  <!-- XV-15 T3: baris DELETE pada tabel caffaine terbukti dieksekusi
       (aksi privilese benar-benar terjadi, bukan hanya diminta). -->
  <rule id="100415" level="11">
    <if_sid>100120</if_sid>
    <field name="asiw_db_query" type="pcre2">(?i)delete\s+from\s+caffaine</field>
    <description>ASIW XV-15 T3: Privileged delete executed on caffaine table (access control bypass confirmed).</description>
    <mitre><id>T1190</id></mitre>
    <group>host,access_control,db,asiw_t3,</group>
  </rule>

  <!-- XV-16 T3: password user benar-benar berubah (UPDATE users set password).
       Dipakai untuk mengonfirmasi CSRF berhasil. -->
  <rule id="100416" level="11">
    <if_sid>100120</if_sid>
    <field name="asiw_db_query" type="pcre2">(?i)update\s+users\s+set\s+password</field>
    <description>ASIW XV-16 T3: User password changed in xvwa database (confirm whether request was CSRF).</description>
    <mitre><id>T1098</id></mitre>
    <group>host,csrf,db,asiw_t3,</group>
  </rule>

  <!-- ================================================================
       1005NN : KORELASI LINTAS SUMBER
       ================================================================ -->

  <!-- Webshell terunggah, lalu file itu diakses lewat web.
