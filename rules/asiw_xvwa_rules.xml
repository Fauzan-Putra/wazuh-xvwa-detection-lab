    <mitre><id>T1505.003</id></mitre>
    <group>correlation,web_shell,asiw_t3,</group>
  </rule>

  <!-- Percobaan command injection (T1 web) diikuti bukti eksekusi di host. -->
  <rule id="100503" level="14" timeframe="120">
