# =====================================================================
# ASIW: nilai spesifik infrastruktur
# ---------------------------------------------------------------------
# Salin berkas ini menjadi asiw.env lalu isi dengan nilai NYATA:
#
#     cp asiw.env.example asiw.env
#     nano asiw.env
#
# asiw.env SENGAJA dimasukkan ke .gitignore dan TIDAK boleh di-commit.
#
# MENGAPA DIPISAHKAN DARI REPOSITORI
# PRD ASIW Bagian 12 (Privasi) menetapkan: "Tidak ada IP internal ke
# layanan eksternal tanpa masking." Repositori GitHub public ADALAH
# layanan eksternal. Memublikasikan IP infrastruktur nyata, terutama
# yang menjalankan aplikasi sengaja-rentan, memberi informasi recon
# bagi siapa pun yang memperoleh akses ke jaringan internal
# (risiko R14 pada PRD).
#
# Nilai bawaan di bawah memakai rentang dokumentasi RFC 5737
# (192.0.2.0/24, 198.51.100.0/24, 203.0.113.0/24) yang tidak dapat
# dirutekan dan memang diperuntukkan untuk contoh.
# =====================================================================

# --- IP Wazuh Manager / VM Monitoring --------------------------------
# Dipakai rule suppression 100901 (health check berkala ke root XVWA).
# Bila salah, health check rutin akan tampil sebagai alert serangan.
ASIW_MONITOR_IP="192.0.2.148"

# --- Nama agent group ------------------------------------------------
ASIW_GROUP="asiw-xvwa-targets"

# --- ID agent VM Target yang dimasukkan ke grup ----------------------
# Lihat daftarnya: /var/ossec/bin/agent_control -l
ASIW_AGENT_IDS="001 002 003"

# --- Lokasi aplikasi XVWA pada VM Target -----------------------------
# Verifikasi: grep -rh DocumentRoot /etc/apache2/sites-enabled/
ASIW_XVWA_DIR="/var/www/html/xvwa"

# --- Host penyerang lab (opsional) -----------------------------------
# JANGAN di-suppress. Dipakai layer normalisasi untuk memberi tag
# lab_attacker, agar serangan uji dapat dibedakan dari insiden nyata
# saat evaluasi (XVWA_Detection_Mapping_ASIW.md bagian 2.4).
ASIW_LAB_ATTACKER_IP=""
